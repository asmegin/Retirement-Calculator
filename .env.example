# Copy to .env for Docker Compose. A direct Node launch needs process variables.
APP_VERSION=1.0.5
HOST_PORT=3333
# Match the owner of the data directory. Unraid commonly uses 99:100.
APP_UID=1000
APP_GID=1000

# Set both credentials before enabling authentication. Do not commit .env.
BASIC_AUTH_ENABLED=false
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
